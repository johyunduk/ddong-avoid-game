# graphify 코퍼스에서 뺄 것 (gitignore 문법)
#
# 이 그래프는 **코드와 설계 근거**를 답하기 위한 것이다. 아래는 그 질문에
# 답하지 않으면서 추출 비용만 크게 먹는 것들이다.
# 되살리려면 해당 줄을 지우고 `graphify update .` 를 다시 돌린다.

# 캐릭터 제작 작업물 — 컨셉·가사·후보 이미지. 배치 140개분 1,000여 개가 쌓여 있고
# 코드 구조와 이어지지 않는다 (이어지는 것은 src/utils/character.ts 쪽 등록이다).
creative/

# 캐릭터별 진행 상태 yaml. 계속 바뀌는 운영 데이터지 구조가 아니다.
production/

# 에셋 전부. "코드"로 잡히는 것은 스프라이트 아틀라스 JSON 이고,
# 이미지 354장은 한 장당 비전 서브에이전트가 하나씩 붙어 비용이 폭발한다.
# 에셋이 어떻게 쓰이는지는 이미 src/ 의 참조가 말해 준다.
public/

# SNS 산출물
release/
