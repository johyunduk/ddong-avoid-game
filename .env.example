# Upstash Redis 설정
# 이 파일을 .env.local로 복사하고 실제 값을 입력하세요

UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# 게임 점수 검증용 HMAC 비밀 키
# 강력한 랜덤 문자열 사용 (최소 32자 이상)
# 생성 방법: openssl rand -hex 32
GAME_SECRET_KEY=your-super-secret-key-change-this-in-production

# 클라이언트용 검증 키 (VITE_ 접두사 필수)
# 주의: 클라이언트 코드에 포함되므로 완벽한 보안은 아님
# 서버 검증이 최종 방어선
VITE_GAME_SECRET_KEY=your-client-secret-key-change-this-in-production

# API 서버 URL (앱인투스 배포용)
# 로컬 개발 시에는 필요 없음 (localhost:5173 자동 사용)
# 프로덕션: Vercel 배포 URL로 변경하세요
VITE_API_BASE_URL=http://localhost:8000
