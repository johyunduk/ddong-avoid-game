# 이 파일을 .env.local로 복사하고 실제 값을 입력하세요

# ─── Supabase 설정 ───────────────────────────────────────────
# Supabase Dashboard → Settings → API 에서 확인
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 서버 전용 (절대 클라이언트에 노출 금지 — VITE_ 접두사 없음)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── 게임 점수 검증 (서버 사이드 전용) ───────────────────────
# 생성 방법: openssl rand -hex 32
GAME_SECRET_KEY=your-super-secret-key-change-this-in-production

# ─── 일러스트 심사 페이지 ────────────────────────────────────
# 심사 페이지(review-site/) 가 배포된 주소. 게임 사이트와 분리된 별도 프로젝트다.
# 심사 링크가 <이 주소>/?b=...&t=... 로 만들어진다
REVIEW_SITE_URL=https://ddong-review.vercel.app
